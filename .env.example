# ─────────────────────────────────────────────────────────────
# Golden Sierra Workforce Navigator — environment template
# Copy to .env and fill in. Never commit the filled-in .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://gs:gs@localhost:5433/goldensierra?schema=public

# ── Qdrant vector database ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=gs_knowledge

# ── Redis (BullMQ background jobs) ───────────────────────────
# Optional. If unset, ingestion runs inline in-process instead.
REDIS_URL=redis://localhost:6379

# ── Language model (OpenAI-compatible; works with OpenRouter) ─
# For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ── Embedding model ──────────────────────────────────────────
# OpenAI: text-embedding-3-small (1536) / text-embedding-3-large (3072)
# BGE-M3 via a local OpenAI-compatible server: set
#   EMBEDDING_BASE_URL=http://localhost:8080/v1
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ── Retrieval tuning ─────────────────────────────────────────
RETRIEVAL_TOP_K=24
RETRIEVAL_FINAL_K=8
RETRIEVAL_MIN_SCORE=0.25
RERANK_ENABLED=true
RERANK_MODEL=
HYBRID_KEYWORD_WEIGHT=0.35

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ── Crawler ──────────────────────────────────────────────────
CRAWL_USER_AGENT=GoldenSierraNavigatorBot/1.0 (+workforce assistant; contact admin)
CRAWL_CONCURRENCY=3
CRAWL_DELAY_MS=800
CRAWL_MAX_PAGES=300
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_MS=30000
CRAWL_RESPECT_ROBOTS=true
# Comma-separated hostnames the crawler is authorized to index.
CRAWL_ALLOWED_HOSTS=goldensierra.com,www.goldensierra.com
# Optional Firecrawl; falls back to fetch+Cheerio when absent.
FIRECRAWL_API_KEY=

# ── Auth / security ──────────────────────────────────────────
# Generate: openssl rand -base64 48
AUTH_SECRET=
SESSION_TTL_HOURS=12
CHAT_RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_CHARS=2000
MAX_UPLOAD_BYTES=20971520

# ── Data retention ───────────────────────────────────────────
CHAT_RETENTION_DAYS=30
