# ─────────────────────────────────────────────────────────────
# Golden Sierra Workforce Navigator — environment template
# Copy to .env and fill in. Never commit the filled-in .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://gs:gs@localhost:5433/goldensierra?schema=public

# ── Qdrant vector database ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=gs_knowledge

# ── Redis (BullMQ background jobs) ───────────────────────────
# Optional. If unset, ingestion runs inline in-process instead.
REDIS_URL=redis://localhost:6379

# ── Language model (OpenAI-compatible protocol) ───────────────
# Inception Labs (current):  https://api.inceptionlabs.ai/v1  · mercury-3
# OpenAI:                    https://api.openai.com/v1        · gpt-4o-mini
# OpenRouter:                https://openrouter.ai/api/v1     · any slug
LLM_PROVIDER=inception
LLM_API_KEY=
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_MODEL=mercury-3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ── Embedding model ──────────────────────────────────────────
# EMBEDDING_PROVIDER=local   runs in-process via Transformers.js. No API key,
#   no network after the first download. Required when the chat provider has
#   no embeddings endpoint — Inception Labs does not.
#     EMBEDDING_MODEL=Xenova/bge-small-en-v1.5   EMBEDDING_DIMENSIONS=384
#     EMBEDDING_MODEL=Xenova/bge-base-en-v1.5    EMBEDDING_DIMENSIONS=768
#
# EMBEDDING_PROVIDER=openai  uses any OpenAI-compatible endpoint:
#     text-embedding-3-small (1536) / text-embedding-3-large (3072)
#     or self-hosted BGE-M3 (1024) behind TEI/vLLM
#
# Changing the model or dimensions REQUIRES a re-index. Startup refuses to run
# against a dimension-mismatched collection rather than corrupting search.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64

# ── Retrieval tuning ─────────────────────────────────────────
RETRIEVAL_TOP_K=40
RETRIEVAL_FINAL_K=8
RETRIEVAL_MIN_SCORE=0.25
RERANK_ENABLED=true
RERANK_MODEL=
HYBRID_KEYWORD_WEIGHT=0.35

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ── Crawler ──────────────────────────────────────────────────
CRAWL_USER_AGENT=GoldenSierraNavigatorBot/1.0 (+workforce assistant; contact admin)
CRAWL_CONCURRENCY=3
CRAWL_DELAY_MS=800
CRAWL_MAX_PAGES=300
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_MS=30000
CRAWL_RESPECT_ROBOTS=true
# Comma-separated hostnames the crawler is authorized to index.
CRAWL_ALLOWED_HOSTS=goldensierra.com,www.goldensierra.com
# Optional Firecrawl; falls back to fetch+Cheerio when absent.
FIRECRAWL_API_KEY=

# ── Auth / security ──────────────────────────────────────────
# Generate: openssl rand -base64 48
AUTH_SECRET=
SESSION_TTL_HOURS=12
CHAT_RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_CHARS=2000
MAX_UPLOAD_BYTES=20971520

# ── Data retention ───────────────────────────────────────────
CHAT_RETENTION_DAYS=30
